# The Vercel front controller is api/index.php. Keeping public/index.php out of
# the deployment stops it from being served as a static file from the output
# directory, which would leak the file's source.
public/index.php
public/hot
public/storage

# Laravel's package manifest is generated locally with dev dependencies, but
# Vercel installs with --no-dev. Shipping the stale manifest makes the app boot
# looking for dev-only providers such as Pail. Let the build regenerate it.
bootstrap/cache/*.php

node_modules
tests
docs
storage/logs/*.log
docker-compose.yml
.github
