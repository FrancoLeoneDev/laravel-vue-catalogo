# The Vercel front controller is api/index.php. Keeping public/index.php out of
# the deployment stops it from being served as a static file from the output
# directory, which would leak the file's source.
public/index.php
public/hot
public/storage

# The package manifest is generated locally with dev dependencies, but Vercel
# installs with --no-dev and does not run Composer scripts. Rather than ship a
# manifest, APP_PACKAGES_CACHE / APP_SERVICES_CACHE point Laravel at /tmp so it
# builds a correct one on the first request.
bootstrap/cache/*.php

node_modules
tests
docs
storage/logs/*.log
docker-compose.yml
.github
